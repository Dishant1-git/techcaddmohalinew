# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored — never commit real credentials.

# --- MySQL (website enquiry storage) ---------------------------------------
# These must match the connection you use in MySQL Workbench.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=techcadd_mohali

# Optional — connections held open in the pool. Default 10.
# MYSQL_POOL_SIZE=10
CAPTCHA_SECRET=change-me-to-a-long-random-string
