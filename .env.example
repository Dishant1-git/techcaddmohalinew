# Copy to .env.local and fill in. Nothing here is read at build time unless a
# page actually renders — an unset CMS_API_URL is a valid configuration in
# which the site serves the built-in content in src/lib/*.ts.

# --- CMS ---------------------------------------------------------------------
# Where cms-techcadd/backend is listening. In development that is 4100 on this
# machine, because the Amritsar project already owns 4000.
CMS_API_URL=http://localhost:4100

# Where the CMS serves /uploads from. Usually the same host as the API.
CMS_MEDIA_URL=http://localhost:4100

# Must be identical to REVALIDATE_SECRET in cms-techcadd/backend/.env — it is
# what authenticates the CMS's call to /api/revalidate after a save. Generate
# one with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
REVALIDATE_SECRET=generate-a-long-random-string

# Backstop cache window, in seconds, used when the webhook above is lost.
CMS_REVALIDATE_SECONDS=600
# How long a single CMS read may take before the page falls back.
CMS_TIMEOUT_MS=10000

# --- website database (enquiries) -------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
# Quote it. A '#' outside quotes starts a comment, which silently truncates the
# password and surfaces as "Access denied for user 'root'@'localhost'".
MYSQL_PASSWORD="your-password"
MYSQL_DATABASE=techcadd_mohali

# --- forms -------------------------------------------------------------------
# Must be set in production, or the course-page captcha falls back to a known
# development key.
CAPTCHA_SECRET=
